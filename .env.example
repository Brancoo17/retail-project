# ====================================================================
# BASE DE DATOS (Local / Hostinger / Producción)
# ====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=retail_mvc

# ====================================================================
# APLICACIÓN Y DEPURACIÓN
# ====================================================================
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000

# ====================================================================
# MERCADO PAGO (Checkout Pro - Sandbox / Producción)
# ====================================================================
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ====================================================================
# CONFIGURACIÓN DE CORREO SMTP (PHPMailer)
# Mailtrap para desarrollo o Gmail SMTP para producción
# ====================================================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=pedidos@retail.com
MAIL_ENCRYPTION=tls
